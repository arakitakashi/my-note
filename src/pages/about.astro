---
import BaseLayout from "../layouts/BaseLayout.astro";
import styles from "../styles/AboutPage.module.css";

const pageTitle = "About | Araki Takashi";
const pageDescription = "AI エンジニア Araki Takashi のプロフィール。エンタープライズ AI の導入と実装（RAG・AI エージェント・LLM 評価）に取り組んでいます。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class={styles.wrapper}>
    <div class={styles.inner}>
      <h1 class={styles.title}>About</h1>
      <div class={styles.body}>
        <div class={styles.english}>
          <p class={styles.subtitle}>Araki Takashi</p>
          <p>
            I'm an AI engineer based in Tokyo. I build enterprise AI
          platforms and AI products. <br />
          I write here about RAG, AI agents, and LLM evals.
          </p>
        </div>
        <div class={styles.japanese}>
          <p class={styles.subtitle}>荒木　聖</p>
          <p>
            東京在住の AI エンジニアです。事業会社でエンタープライズ AI 基盤の構築と AI プロダクトの開発をしています。
  このサイトでは RAG・AI エージェント・LLM 評価（Evals）について書いています。
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
