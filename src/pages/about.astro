---
import BaseLayout from "../layouts/BaseLayout.astro";
import styles from "../styles/AboutPage.module.css";

const pageTitle = "About | Araki Takashi";
const pageDescription = "デジタルプロダクトのデザイナー・エンジニアであるAraki Takashiのプロフィール。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class={styles.wrapper}>
    <div class={styles.inner}>
      <h1 class={styles.title}>About</h1>
      <div class={styles.body}>
        <div class={styles.english}>
          <p class={styles.subtitle}>Araki Takashi</p>
          <p>
            I am a Tokyo-based🇯🇵 designer and engineer of digital products, <br />
          dedicated to creating work that enriches everyday life—even in small
          ways 🌊
          </p>
        </div>
        <div class={styles.japanese}>
          <p class={styles.subtitle}>荒木　聖</p>
          <p>
            東京を拠点とするデジタルプロダクトのデザイナー・エンジニアです。
  日々の暮らしを、たとえ小さな形でも豊かにする作品づくりに情熱を注いでいます。🌊
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
