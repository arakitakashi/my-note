---
import BaseLayout from "../layouts/BaseLayout.astro";
import styles from "../styles/ProductsPage.module.css";

const pageTitle = "Products | Araki Takashi";
const pageDescription = "AI エンジニア Araki Takashi が開発・公開しているプロダクト（AI エージェント・RAG・評価ツール）を紹介するページです。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class={styles.wrapper}>
    <div class={styles.inner}>
      <h1 class={styles.title}>Products</h1>
      <p class={styles.subtitle}>作品集</p>
      <div class={styles.body}>
        <p>
          AI エージェント・RAG・LLM 評価など、個人で開発中のプロダクトをまとめる
          ページです。プロトタイプの公開にあわせて順次追加していきます。
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
